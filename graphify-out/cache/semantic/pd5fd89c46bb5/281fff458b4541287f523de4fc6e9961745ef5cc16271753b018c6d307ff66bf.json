{"nodes": [{"id": "github_copilot_instructions_doc", "label": "Copilot Instructions (Repository Guidance)", "file_type": "document", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_copilot_instructions_climustreusesharedfunctions", "label": "CLI Must Reuse Shared Functions (principle)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLI is a thin consumer of shared src/ modules; reimplementing session parsing/cost attribution in the CLI would diverge from VS Code's getSessionFileDataCached pattern and break delta-format (VS Code Chat JSONL) attribution since estimateTokensFromJsonlSession().modelUsage returns {} for that format."}, {"id": "github_copilot_instructions_neverlaunchrealeditor", "label": "Never Launch a Real Editor/IDE Instance (principle)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents cannot observe or close GUI windows they open (code ., F5 Extension Dev Host, gradlew runIde, devenv), so launching them mid-session is disruptive and meaningless for automated verification; unattended coding-agent sessions (auto_issue_session) would pop a real window with nobody there to close it."}, {"id": "github_copilot_instructions_mirroredagentsskillssync", "label": "Keep Claude Code's Mirrored Agents & Skills in Sync (mechanism)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code does not read .github/agents/ or .github/skills/ on its own, so .claude/agents and .claude/skills copies must be manually kept in sync in the same PR or they silently go stale."}, {"id": "github_copilot_instructions_devcontainerterminalbehavior", "label": "DevContainer Terminal Behavior (known limitation)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal output capture inside the devcontainer's remote filesystem layer is unreliable, so agents should avoid retry-polling loops and instead use npm scripts, get_errors, and workspace-local output files."}, {"id": "src_tokenestimation_estimatetokensfromjsonlsession", "label": "tokenEstimation.ts estimateTokensFromJsonlSession()", "file_type": "code", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_tokenestimation_extractalltokensfromdebuglog", "label": "tokenEstimation.ts extractAllTokensFromDebugLog()", "file_type": "code", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_usageanalysis_getmodelusagefromsession", "label": "usageAnalysis.ts getModelUsageFromSession()", "file_type": "code", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devcontainer_devcontainer_config", "label": ".devcontainer/devcontainer.json", "file_type": "code", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "github_copilot_instructions_doc", "target": "github_copilot_instructions_climustreusesharedfunctions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_locati