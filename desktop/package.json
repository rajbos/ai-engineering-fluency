{
  "name": "ai-engineering-fluency-desktop",
  "version": "0.1.0",
  "description": "AI Engineering Fluency - Windows Desktop App",
  "author": "RobBos",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "start": "npm run build && electron .",
    "pack": "npm run build:production && electron-builder --dir",
    "dist": "npm run build:production && electron-builder",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^22.0.0",
    "chalk": "^5.6.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "sql.js": "^1.12.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8",
    "tar": ">=7.5.21"
  },
  "build": {
    "appId": "com.rajbos.ai-engineering-fluency",
    "productName": "AI Engineering Fluency",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "appx": {
      "applicationId": "RajBos.AIEngineeringFluency",
      "displayName": "AI Engineering Fluency",
      "identityName": "RajBos.AIEngineeringFluency"
    },
    "publish": {
      "provider": "github",
      "owner": "rajbos",
      "repo": "ai-engineering-fluency"
    }
  },
  "allowScripts": {
    "electron@42.4.1": true,
    "esbuild@0.25.12": true
  }
}
