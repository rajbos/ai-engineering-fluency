{
  "name": "@rajbos/ai-engineering-fluency",
  "version": "0.5.0",
  "description": "AI Engineering Fluency - CLI tool to analyze GitHub Copilot token usage from local session files",
  "license": "MIT",
  "author": "RobBos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajbos/ai-engineering-fluency.git",
    "directory": "cli"
  },
  "keywords": [
    "github-copilot",
    "token-usage",
    "copilot",
    "cli",
    "token-tracker"
  ],
  "bin": {
    "ai-engineering-fluency": "dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "bundle-exe": "pwsh -NoProfile -File bundle-exe.ps1",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "node dist/cli.js --help && node dist/cli.js --version && npm run test:unit",
    "test:unit": "node esbuild.tests.js && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "sql.js": "^1.12.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
